# Copy to .env and edit:  cp .env.example .env

# Users created on first start (username:Display Name:password; separated by ";").
# Usernames are also the public URLs: /list/edwin and /list/erica.
# Existing users are never overwritten, so change passwords in the app (Account page)
# or with:  docker compose exec wishlist npm run user -- reset-password edwin 'new-pass'
SEED_USERS=edwin:Edwin:change-me-please;erica:Erica:change-me-too

SITE_TITLE=Our Christmas Wish Lists

# Set to true once the site is served over HTTPS (e.g. behind Caddy). Required for secure cookies.
COOKIE_SECURE=false

# Optional: in-app product search with prices + photos via Google Shopping.
# Free tier available at https://serpapi.com  (leave blank to just show store search buttons)
SERPAPI_KEY=
SEARCH_COUNTRY=us
DEFAULT_CURRENCY=USD

# How long logins last, in days.
SESSION_DAYS=30
